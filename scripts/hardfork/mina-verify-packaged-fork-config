#!/usr/bin/env bash

set -Eeuxo pipefail

usage() {
    cat <<EOF
Usage: $0 --network <name> --fork-config <fork-config.json> --working-dir <dir> [options]

Required:
  --network                   Name of the network
  --fork-config               Path to fork_config.json
  --working-dir               Working directory
  --checks                    Checks to perform (comma-separated list). Default: all
                                config    the fork config rebuilds the ledgers of the fork block
                                block     the packaged config holds the seeds, fork point and
                                          ledger hashes of the fork block
                                constants the binary's consensus constants are those of the block
                                artifacts the packaged tarballs are those of the packaged config,
                                          and the prefork package is the pinned one
                                tarballs  packaged, generated and downloaded tarballs are the same
                                ledgers   a daemon on the packaged config exports the same ledgers
                                          as the reference, and starts at the fork point
                                accounts  balances and timing in those exports are those of the
                                          fork config (needs ledgers in the same run)

Optional:
  --precomputed-block-prefix  Precomputed block prefix
  --reference-data-dir        Reference data directory. Defaults to empty, which skips comparison with reference data.
  --cached-hardfork-data      Path to cached hardfork data directory
  --expect-config-mismatch    Succeed only if the config check finds a hash mismatch: the fork
                              config is corrupted on purpose. Any other failure stays a failure.
  --ledger-migration          The fork changes the account format, so ledger hashes and accounts
                              differ from the fork block by design. Skips comparing them.
  --changed-constants LIST    Comma-separated consensus constants this fork changes on purpose
  --prefork-version VERSION   The version the prefork genesis package must have

This script is used to validate that an installed package is correct
according to an exported fork_config.json file.

Inputs:
- The exported mainnet full config.json fork config, with all accounts
- A working directory where ledgers/configs will be created
- Installed MINA_EXE (default: mina) and MINA_GENESIS_EXE (default: mina-create-genesis) programs
- Installed MINA_LEGACY_GENESIS_EXE program (default: mina-legacy-create-genesis)
- PACKAGED_DAEMON_CONFIG (default: /var/lib/coda/config_*.json)
  the runtime config generated by the HF packaging
- CREATE_RUNTIME_CONFIG (default: mina-hf-create-runtime-config)
  a copy of ./scripts/hardfork/create_runtime_config.sh
- GENESIS_LEDGER_DIR (default: /var/lib/coda)
  where the tarfiles to verify are stored
- FORKING_FROM_CONFIG_JSON (default: /var/lib/coda/mainnet.json)
  the pre-fork genesis ledger
- SECONDS_PER_SLOT (default: 180)
- PRECOMPUTED_FORK_BLOCK (default: fetches with gsutil)
- GSUTIL (default: gsutil)
  the Google Cloud Storage utility if the PRECOMPUTED_FORK_BLOCK isn't a file
- MINA_LOG_LEVEL (default: info)
  the log level to run the Mina node at when exporting ledgers

Ensures:
- The accounts listed in config.json are the ones in the PACKAGED_DAEMON_CONFIG
- The genesis ledger directory tarfile contents match reference copies created
  fresh from config.json. This takes a long time (>20min) due to rehashing.

Outputs:
- Exit code 0 if validated, 1 otherwise.
EOF

    exit 1
}

PRECOMPUTED_BLOCK_PREFIX=""
CACHED_HARDFORK_DATA=""
CHECKS="config,block,constants,artifacts,tarballs,ledgers,accounts"
EXPECT_CONFIG_MISMATCH=0
LEDGER_MIGRATION=0
CHANGED_CONSTANTS=""
PREFORK_VERSION=""

# Track if any errors occurred
error=0

# Parse named flags
while [[ $# -gt 0 ]]; do
    case $1 in
        --network)
            NETWORK_NAME="$2"
            shift 2
            ;;
        --fork-config)
            FORK_CONFIG="$2"
            shift 2
            ;;
        --working-dir)
            WORKDIR="$2"
            shift 2
            ;;
        --precomputed-block-prefix)
            PRECOMPUTED_BLOCK_PREFIX="$2"
            shift 2
            ;;
        --reference-data-dir)
            REFERENCE_DATA_DIR="$2"
            shift 2
            ;;
        --cached-hardfork-data)
            CACHED_HARDFORK_DATA="$2"
            shift 2
            ;;
        --checks)
            CHECKS="$2"
            shift 2
            ;;
        --expect-config-mismatch)
            EXPECT_CONFIG_MISMATCH=1
            shift
            ;;
        --ledger-migration)
            LEDGER_MIGRATION=1
            shift
            ;;
        --changed-constants)
            CHANGED_CONSTANTS="$2"
            shift 2
            ;;
        --prefork-version)
            PREFORK_VERSION="$2"
            shift 2
            ;;
        -*)
            echo "Unknown option $1"
            usage
            ;;
        *)
            echo "Unexpected argument $1"
            usage
            ;;
    esac
done


# Validate required arguments
if [[ -z "$NETWORK_NAME" ]]; then
    echo "Error: --network is required"
    usage
fi

if [[ -z "$FORK_CONFIG" ]]; then
    echo "Error: --fork-config is required"
    usage
fi

if [[ -z "$WORKDIR" ]]; then
    echo "Error: --working-dir is required"
    usage
fi

function checks_contains() {
    local check=$1
    IFS=',' read -ra CHECKS_ARRAY <<< "$CHECKS"
    for c in "${CHECKS_ARRAY[@]}"; do
        if [[ "$c" == "$check" ]]; then
            return 0
        fi
    done
    return 1
}

source_build_fallback() {
    v=$(command -v "$1")
    if [ ! -x "$v" ]; then
        if [ ! -x "$2" ]; then
            echo "Error: program not found in PATH (as $1) or relative to cwd (as $2)" >&2
            exit 1
        else
            echo "$2"
        fi
    else
      echo "$1"
    fi
}

MINA_EXE=${MINA_EXE:-$(source_build_fallback mina ./_build/default/src/app/cli/src/mina.exe)}
MINA_GENESIS_EXE=${MINA_GENESIS_EXE:-$(source_build_fallback mina-create-genesis ./_build/default/src/app/runtime_genesis_ledger/runtime_genesis_ledger.exe)}
MINA_LEGACY_GENESIS_EXE=${MINA_LEGACY_GENESIS_EXE:-$(source_build_fallback mina-create-prefork-genesis ./runtime_genesis_ledger_of_mainnet.exe)}
CREATE_RUNTIME_CONFIG=${CREATE_RUNTIME_CONFIG:-$(source_build_fallback mina-hf-create-runtime-config ./scripts/hardfork/create_runtime_config.sh)}
MINA_ROCKSDB_SCANNER=${MINA_ROCKSDB_SCANNER:-$(source_build_fallback mina-rocksdb-scanner ./_build/default/src/app/rocksdb-scanner/rocksdb_scanner.exe)}
GSUTIL=${GSUTIL:-$(command -v gsutil || echo "")}

if [[ ! -e "${PRECOMPUTED_FORK_BLOCK:-}" && ( -z "$GSUTIL" || ! -x "$GSUTIL" ) ]]; then
    echo "Error: gsutil is required when PRECOMPUTED_FORK_BLOCK is nonexistent path"
    exit 1
fi

installed_config=$(echo /var/lib/coda/config_*.json)
PACKAGED_DAEMON_CONFIG=${PACKAGED_DAEMON_CONFIG:-$installed_config}
if [ ! -e "$PACKAGED_DAEMON_CONFIG" ]; then
    echo "Error: set PACKAGED_DAEMON_CONFIG to the path to the JSON file to verify"
    exit 1
fi

GENESIS_LEDGER_DIR=${GENESIS_LEDGER_DIR:-"/var/lib/coda"}

SECONDS_PER_SLOT=${SECONDS_PER_SLOT:=180}

export FORKING_FROM_CONFIG_JSON=${FORKING_FROM_CONFIG_JSON:-$(source_build_fallback /var/lib/coda/mainnet.json genesis_ledgers/mainnet.json)}

export MINA_LIBP2P_PASS=''

mkdir -p "$WORKDIR"/{ledgers{,-backup},keys}
chmod 700 "$WORKDIR/keys"

fork_point=$(jq -r '.proof.fork | [.state_hash, .blockchain_length, .global_slot_since_genesis] | @tsv' "$FORK_CONFIG")
read -r fork_block_state_hash fork_block_length fork_global_slot <<< "$fork_point"

# Fetch the precomputed fork block from local file or gcloud
fetch_precomputed_fork_block() {
    local network_name=$1
    local fork_block_length=$2
    local fork_block_state_hash=$3
    local precomputed_block_prefix=$4
    local dst=$5

    # Put the fork block where we want it, fetch it from gcloud if necessary
    if [[ -z "${PRECOMPUTED_FORK_BLOCK:-}" ]]; then
        PRECOMPUTED_FORK_BLOCK="${precomputed_block_prefix:-gs://mina_network_block_data/$network_name}-$fork_block_length-$fork_block_state_hash.json"
    fi

    local src="$PRECOMPUTED_FORK_BLOCK"
    if [[ -e "$src" ]]; then
        cp "$src" "$dst"
    else
        "$GSUTIL" cp "$src" "$dst"
    fi
}

# The fork block, once per run.
function fork_block() {
    local dst="$WORKDIR/precomputed_fork_block.json"
    if [ ! -e "$dst" ]; then
        fetch_precomputed_fork_block "$NETWORK_NAME" "$fork_block_length" "$fork_block_state_hash" "$PRECOMPUTED_BLOCK_PREFIX" "$dst"
    fi
}

# Records one failed comparison. Later checks still run, so that a run reports
# every mismatch at once. Callers assign the mismatches to a variable first: a
# failed command in an argument would not stop the script, and an empty result
# reads as a pass.
function report_mismatches() {
    local what=$1 mismatches=$2
    if [ -n "$mismatches" ]; then
        echo "Error: $what:" >&2
        echo "$mismatches" >&2
        error=1
    fi
}

# export the packaged ledgers in a way where we know which one is which
function extract_ledgers() {
    config_file=$1
    ledger_dir=$2
    json_prefix=$3
    genesis_block_json=${4:-}

    "$MINA_EXE" daemon --libp2p-keypair "$WORKDIR/keys/p2p" \
      --config-file "$config_file" --config-file "$override_file" \
      --seed --genesis-ledger-dir "$ledger_dir" \
      --log-level "${MINA_LOG_LEVEL:-info}" &

    while ! "$MINA_EXE" ledger export staged-ledger  | jq . 2>/dev/null >"$json_prefix-staged.json"; do
        sleep 1m
        if ! grep -qFx "$(cat ~/.mina-config/.mina-lock)" <(jobs -rp); then
            echo "daemon died before exporting ledgers" >&2
            exit 1
        fi
    done

    "$MINA_EXE" ledger export staking-epoch-ledger | jq . > "$json_prefix-staking.json"
    "$MINA_EXE" ledger export next-epoch-ledger | jq . > "$json_prefix-next.json"

    if [ -n "$genesis_block_json" ]; then
        curl -sf -H 'Content-Type: application/json' \
            -d '{"query":"{genesisBlock{protocolState{consensusState{blockHeight slotSinceGenesis slot totalCurrency}}}}"}' \
            http://127.0.0.1:3085/graphql > "$genesis_block_json"
    fi

    "$MINA_EXE" client stop
}

already_restored=0
function restore_or_generate_hardfork_data() {
    if [ $already_restored -eq 1 ]; then
        return
    fi
    already_restored=1

    if [ -n "$CACHED_HARDFORK_DATA" ]; then
        echo "Restoring cached hardfork data from $CACHED_HARDFORK_DATA" >&2

        # Check if cached files exist
        if [ ! -d "$CACHED_HARDFORK_DATA/ledgers" ]; then
            echo "Warning: Cached ledgers directory not found at $CACHED_HARDFORK_DATA/ledgers" >&2
            echo "Falling back to generating ledgers..." >&2
            "$MINA_GENESIS_EXE" --config-file "$FORK_CONFIG" --genesis-dir "$WORKDIR/ledgers" --hash-output-file "$WORKDIR/hashes.json"
        elif [ ! -f "$CACHED_HARDFORK_DATA/hashes.json" ]; then
            echo "Warning: Cached hashes.json file not found at $CACHED_HARDFORK_DATA/hashes.json" >&2
            echo "Falling back to generating ledgers..." >&2
            "$MINA_GENESIS_EXE" --config-file "$FORK_CONFIG" --genesis-dir "$WORKDIR/ledgers" --hash-output-file "$WORKDIR/hashes.json"
        else
            # Copy cached files
            cp -r "$CACHED_HARDFORK_DATA"/ledgers/*.tar.gz "$WORKDIR/ledgers"/
            cp "$CACHED_HARDFORK_DATA/hashes.json" "$WORKDIR/hashes.json"
            echo "Successfully restored cached hardfork data" >&2
        fi
    else
        "$MINA_GENESIS_EXE" --config-file "$FORK_CONFIG" --genesis-dir "$WORKDIR/ledgers" --hash-output-file "$WORKDIR/hashes.json"
    fi
}

if [ -z "${REFERENCE_DATA_DIR:-}" ]; then
    echo "generating genesis ledgers ... (this may take a while)" >&2
    "$MINA_LEGACY_GENESIS_EXE" --config-file "$FORK_CONFIG" --genesis-dir "$WORKDIR/legacy_ledgers" --hash-output-file "$WORKDIR/legacy_hashes.json"
    REFERENCE_DATA_DIR="$WORKDIR"
else
    if [[ ! -d "$REFERENCE_DATA_DIR" ]]; then
        echo "Error: reference data dir $REFERENCE_DATA_DIR does not exist" >&2
        exit 1
    fi
    echo "using reference data dir: $REFERENCE_DATA_DIR. Skipping legacy ledger generation." >&2
fi

if checks_contains config; then
    echo "Validating config..." >&2

    fork_block

    result=$(jq --slurpfile block "$WORKDIR/precomputed_fork_block.json" \
    --slurpfile legacy_hashes "$REFERENCE_DATA_DIR/legacy_hashes.json" -n '
    ($legacy_hashes[0].epoch_data.staking.hash == $block[0].data.protocol_state.body.consensus_state.staking_epoch_data.ledger.hash and
    $legacy_hashes[0].epoch_data.next.hash == $block[0].data.protocol_state.body.consensus_state.next_epoch_data.ledger.hash and
    $legacy_hashes[0].ledger.hash == $block[0].data.protocol_state.body.blockchain_state.staged_ledger_hash.non_snark.ledger_hash)')

    if [ "$result" != "true" ]; then
        echo "Hashes in config $FORK_CONFIG don't match hashes from the precomputed block $PRECOMPUTED_FORK_BLOCK" >&2
        if [ "$EXPECT_CONFIG_MISMATCH" -eq 1 ]; then
            echo "The mismatch was expected: the corrupted config is rejected" >&2
            exit 0
        fi
        exit 1
    fi

    if [ "$EXPECT_CONFIG_MISMATCH" -eq 1 ]; then
        echo "Error: the corrupted config $FORK_CONFIG was accepted" >&2
        exit 1
    fi

    # Exactly these two keys: none missing, and no stop slot of the old network.
    result=$(jq --slurpfile prefork "$FORKING_FROM_CONFIG_JSON" '
    .daemon == ($prefork[0].daemon | {network_id, peer_list_url})' "$PACKAGED_DAEMON_CONFIG")

    if [ "$result" != "true" ]; then
        echo "The daemon section of $PACKAGED_DAEMON_CONFIG is not network_id and peer_list_url of $FORKING_FROM_CONFIG_JSON" >&2
        exit 1
    fi
else
    echo "Skipping config validation as per --checks option" >&2
fi

if checks_contains block; then
    echo "Validating the packaged config against the fork block..." >&2

    fork_block

    # The ledger hashes here are the independent ones: the ledgers and tarballs
    # checks compare the packaged ledgers with cached copies of themselves.
    mismatches=$(
    jq -r --slurpfile block "$WORKDIR/precomputed_fork_block.json" \
    --arg state_hash "$fork_block_state_hash" --argjson migration "$LEDGER_MIGRATION" '
    $block[0].data.protocol_state.body as $body |
    $body.consensus_state as $c |
    (   [ ["fork state hash", .proof.fork.state_hash, $state_hash]
        , ["blockchain length", .proof.fork.blockchain_length, $c.blockchain_length]
        , ["global slot since genesis", .proof.fork.global_slot_since_genesis, $c.global_slot_since_genesis]
        , ["staking seed", .epoch_data.staking.seed, $c.staking_epoch_data.seed]
        , ["next seed", .epoch_data.next.seed, $c.next_epoch_data.seed]
        ]
      + if $migration == 1 then [] else
        [ ["ledger hash", .ledger.hash, $body.blockchain_state.staged_ledger_hash.non_snark.ledger_hash]
        , ["staking hash", .epoch_data.staking.hash, $c.staking_epoch_data.ledger.hash]
        , ["next hash", .epoch_data.next.hash, $c.next_epoch_data.ledger.hash]
        ] end
    ) | .[] | select((.[1] | tostring) != (.[2] | tostring)) |
    "\(.[0]): packaged \(.[1]), fork block \(.[2])"' "$PACKAGED_DAEMON_CONFIG")
    report_mismatches "the packaged config is not the fork block" "$mismatches"
else
    echo "Skipping block validation as per --checks option" >&2
fi

if checks_contains constants; then
    echo "Validating the consensus constants against the fork block..." >&2

    fork_block

    compiled_constants=$("$MINA_EXE" advanced compile-time-constants | tail -n 1)

    mismatches=$(
    jq -r --slurpfile block "$WORKDIR/precomputed_fork_block.json" --arg changed "$CHANGED_CONSTANTS" '
    . as $compiled |
    ($changed | split(",")) as $changed |
    $block[0].data.protocol_state.body.constants as $chain |
    ["k", "delta", "slots_per_sub_window", "slots_per_epoch"][] |
    select(. as $name | $changed | index($name) | not) |
    select(($compiled[.] | tostring) != ($chain[.] | tostring)) |
    "\(.): binary \($compiled[.]), fork block \($chain[.])"' <<< "$compiled_constants")
    report_mismatches "the binary's consensus constants are not those of the fork block" "$mismatches"
else
    echo "Skipping constants validation as per --checks option" >&2
fi

if checks_contains artifacts; then
    echo "Validating the packaged artifacts..." >&2

    expected_tarballs=$(jq -r '.ledger.s3_data_hash, .epoch_data.staking.s3_data_hash, .epoch_data.next.s3_data_hash' \
        "$PACKAGED_DAEMON_CONFIG" | sort)
    actual_tarballs=$(for file in "$GENESIS_LEDGER_DIR"/*.tar.gz; do
        openssl dgst -r -sha3-256 "$file" | cut -d' ' -f1
    done | sort)
    if [ "$actual_tarballs" != "$expected_tarballs" ]; then
        report_mismatches "the tarballs in $GENESIS_LEDGER_DIR are not those of $PACKAGED_DAEMON_CONFIG" \
            "tarballs: $(echo "$actual_tarballs" | tr '\n' ' ')config: $(echo "$expected_tarballs" | tr '\n' ' ')"
    fi

    if [ -n "$PREFORK_VERSION" ]; then
        prefork_package="mina-create-${NETWORK_NAME}-prefork-genesis-ledger"
        installed_prefork=$(dpkg-query -W -f='${Version}' "$prefork_package")
        if [ "$installed_prefork" != "$PREFORK_VERSION" ]; then
            report_mismatches "the prefork package is not the pinned one" \
                "$prefork_package: installed $installed_prefork, pinned $PREFORK_VERSION"
        fi
    fi
else
    echo "Skipping artifacts validation as per --checks option" >&2
fi

if checks_contains ledgers; then
    restore_or_generate_hardfork_data

    FORK_CONFIG_JSON="$FORK_CONFIG" \
    LEDGER_HASHES_JSON="$WORKDIR/hashes.json" \
    GENESIS_TIMESTAMP=$(jq -r '.genesis.genesis_state_timestamp' "$PACKAGED_DAEMON_CONFIG") \
    FORKING_FROM_CONFIG_JSON="" \
    "$CREATE_RUNTIME_CONFIG" > "$WORKDIR/config-substituted.json"

    echo "exporting ledgers from running node ... (this may take a while)" >&2

    if [ ! -e "$WORKDIR/keys/p2p" ]; then
        "$MINA_EXE" libp2p generate-keypair --privkey-path "$WORKDIR/keys/p2p"
    fi

    override_file="$WORKDIR/override-genesis-timestamp.json"
    echo "{\"genesis\":{\"genesis_state_timestamp\":\"$(date -u +"%Y-%m-%dT%H:%M:%SZ")\"}}" > "$override_file"

    mkdir -p "$WORKDIR/ledgers-downloaded"

    # The daemons below only export ledgers, and each one also auto-loads the
    # packaged config. They must not fetch its peer list: that reaches the real
    # network, and a failed download kills the daemon.
    cp "$PACKAGED_DAEMON_CONFIG" "$WORKDIR/config-with-daemon.json"
    jq 'del(.daemon)' "$WORKDIR/config-with-daemon.json" > "$PACKAGED_DAEMON_CONFIG"

    mv -t "$WORKDIR/ledgers-backup" "$GENESIS_LEDGER_DIR"/*.tar.gz
    if [ -z ${NO_TEST_LEDGER_DOWNLOAD+z} ]; then
        # We removed all *.tar.gz from GENESIS_LEDGER_DIR (in case it's one of default paths)
        # and expect Mina node to be able to download these from S3
        extract_ledgers "$PACKAGED_DAEMON_CONFIG" "$WORKDIR/ledgers-downloaded" "$WORKDIR/downloaded"
        rm -Rf /tmp/coda_cache_dir/*.tar.gz /tmp/s3_cache_dir/*.tar.gz
    fi
    extract_ledgers "$WORKDIR/config-substituted.json" "$WORKDIR/ledgers" "$WORKDIR/reference"
    mv -t "$GENESIS_LEDGER_DIR" "$WORKDIR/ledgers-backup"/*
    extract_ledgers "$PACKAGED_DAEMON_CONFIG" "$GENESIS_LEDGER_DIR" "$WORKDIR/packaged" "$WORKDIR/genesis-block.json"

    cp "$WORKDIR/config-with-daemon.json" "$PACKAGED_DAEMON_CONFIG"

    echo "Performing final comparisons..." >&2

    result=$(jq --slurpfile a "$WORKDIR/config-substituted.json" --slurpfile b "$PACKAGED_DAEMON_CONFIG" -n '
    ($a[0].epoch_data.staking.hash == $b[0].epoch_data.staking.hash and
    $a[0].epoch_data.next.hash == $b[0].epoch_data.next.hash and
    $a[0].ledger.hash == $b[0].ledger.hash)')

    if [ "$result" != "true" ]; then
        echo "Packaged config hashes in $PACKAGED_DAEMON_CONFIG not expected compared to $WORKDIR/config-substituted.json" >&2
        error=1
    fi

    for file in "$WORKDIR"/packaged-*.json; do
        name=$(basename "$file")
        name=${name%.json}
        name=${name#packaged-}

        if ! cmp "$file" "$WORKDIR/reference-$name.json"; then
            echo "Error: $file does not match reference" >&2
            error=1
        fi
        if [ -z ${NO_TEST_LEDGER_DOWNLOAD+z} ]; then
            if ! cmp "$file" "$WORKDIR/downloaded-$name.json"; then
                echo "Error: $file does not match downloaded" >&2
                error=1
            fi
        fi
    done

    mismatches=$(
    jq -r --arg height "$fork_block_length" --arg slot "$fork_global_slot" '
    .data.genesisBlock.protocolState.consensusState as $c |
    [ ["block height", $c.blockHeight, ($height | tonumber + 1)]
    , ["slot since genesis", $c.slotSinceGenesis, $slot]
    , ["slot since the fork", $c.slot, 0]
    ] | .[] | select((.[1] | tostring) != (.[2] | tostring)) |
    "\(.[0]): daemon \(.[1]), expected \(.[2])"' "$WORKDIR/genesis-block.json")
    report_mismatches "the daemon did not start at the fork point" "$mismatches"
else
    echo "Skipping ledgers validation as per --checks option" >&2
fi

if checks_contains accounts; then
    if ! checks_contains ledgers; then
        echo "Error: the accounts check needs the ledgers check in the same run" >&2
        exit 1
    fi
    if [ "$LEDGER_MIGRATION" -eq 1 ]; then
        echo "Skipping accounts validation: the ledger migration changes them" >&2
    else
        echo "Validating accounts..." >&2

        # python3 and not jq: token symbols are arbitrary bytes, and a balance
        # sum does not fit a double. The sum is the genesis total currency.
        if ! python3 - "$FORK_CONFIG" "$WORKDIR" "$WORKDIR/genesis-block.json" <<'PYTHON'
import json
import sys

fork_config_path, workdir, genesis_block_path = sys.argv[1:]
DEFAULT_TOKEN = "wSHV2S4qX9jFsLjQo8r1BsMLH2ZRKsZx6EJd1sbozGPieEC4Jf"


def load(path):
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        return json.load(f)


def nanomina(amount):
    whole, _, fraction = str(amount).partition(".")
    return int(whole) * 10**9 + int((fraction + "0" * 9)[:9])


def timing(account):
    t = account.get("timing")
    if not t:
        return None
    return (
        nanomina(t["initial_minimum_balance"]),
        int(t["cliff_time"]),
        nanomina(t["cliff_amount"]),
        int(t["vesting_period"]),
        nanomina(t["vesting_increment"]),
    )


def key(account):
    return (account["pk"], account.get("token", DEFAULT_TOKEN))


def summary(accounts):
    return {key(a): (nanomina(a.get("balance", 0)), timing(a)) for a in accounts}


fork_config = load(fork_config_path)
ledgers = {
    "staged": fork_config["ledger"]["accounts"],
    "staking": fork_config["epoch_data"]["staking"]["accounts"],
    "next": fork_config["epoch_data"]["next"]["accounts"],
}

failed = False
for name, accounts in ledgers.items():
    expected = summary(accounts)
    exported = load(f"{workdir}/packaged-{name}.json")
    actual = summary(exported)
    different = [k for k in expected.keys() | actual.keys() if expected.get(k) != actual.get(k)]
    print(f"{name}: {len(actual)} accounts, {len(different)} different", file=sys.stderr)
    for k in sorted(different)[:5]:
        print(f"  {k}: fork config {expected.get(k)}, exported {actual.get(k)}", file=sys.stderr)
    failed = failed or bool(different)

