# Docker images
MINA_DAEMON_IMAGE=minaprotocol/mina-daemon:4.0.0-6850301-jammy-mainnet

# Network
MINA_NETWORK=mainnet
MINA_PEERLIST_URL=https://bootnodes.minaprotocol.com/networks/mainnet.txt

# Required: passphrases for the block producer key and libp2p key
MINA_PRIVKEY_PASS=
MINA_LIBP2P_PASS=

# Mina daemon ports
MINA_REST_PORT=3085
MINA_P2P_PORT=8302
