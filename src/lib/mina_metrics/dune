(library
 (name mina_metrics)
 (public_name mina_metrics)
 (libraries async_kernel logger uri core_kernel)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps
   mina_ppx
   -allow-unannotated-ignores
   -allow-toplevel-expression
   -dont-check-underscored-literal))
 (virtual_modules mina_metrics)
 (default_implementation mina_metrics.prometheus))
