(library
 (name hash_prefix_states)
 (public_name hash_prefix_states)
 (library_flags -linkall)
 (inline_tests
  (flags -verbose -show-counts))
 (libraries
  ;; opam libraries
  core_kernel
  base
  ;; local libraries
  snark_params
  random_oracle
  mina_signature_kind
  hash_prefixes
  hash_prefix_create
  pickles)
 (preprocess
  (pps
   mina_ppx
   -allow-unannotated-ignores
   -allow-toplevel-expression
   -dont-check-underscored-literal))
 (instrumentation
  (backend bisect_ppx))
 (synopsis
  "Values corresponding to the internal state of the Pedersen hash function on the prefixes used in Coda"))
