(rule
 (alias precomputed_block)
 (target hetzner-itn-1-1795.json)
 (deps
  (env_var TEST_PRECOMPUTED_BLOCK_JSON_PATH))
 (enabled_if
  (= %{env:TEST_PRECOMPUTED_BLOCK_JSON_PATH=n} n))
 (action
  (progn
   (run
    curl
    -L
    -o
    %{target}.gz
    https://storage.googleapis.com/o1labs-ci-test-data/precomputed-blocks/hetzner-itn-1-1795-3NL9Vn7Rg1mz8cS1gVxFkVPsjESG1Zu1XRpMLRQAz3W24hctRoD6.json.gz)
   (run gzip -d %{target}.gz)
   ; It seems unreasonable to regenerate the whole json to increment the version number
   ; Once less trivial changes are added we should regenerate it and fix the version number
   (run sed -i s/3/4/ %{target})
   )))

(rule
 (enabled_if
  (<> %{env:TEST_PRECOMPUTED_BLOCK_JSON_PATH=n} n))
 (target hetzner-itn-1-1795.json)
 (deps
  (env_var TEST_PRECOMPUTED_BLOCK_JSON_PATH))
 (action
  (progn
   (copy %{env:TEST_PRECOMPUTED_BLOCK_JSON_PATH=n} %{target}))))

(test
 (name main)
 (libraries
  alcotest
  async
  core_kernel
  disk_cache.lmdb
  mina_base
  mina_block
  mina_state
  yojson)
 (deps
  hetzner-itn-1-1795.json
  mainnet-520000-3NKuyY4iqW7mXThknMwwNiKst67uo6txzhWFJj3S9fk1jot8M7Qn.json
  mainnet-545000-3NKc1wHM45SweeqiCZyNwmNJQnT4vjzJmeCYkG83YqXNgDPY57ZD.json
  regtest-devnet-319281-3NKq8WXEzMFJH3VdmK4seCTpciyjSY2Rf39K7q1Yyt1p4HkqSzqA.json)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps ppx_jane ppx_version)))
