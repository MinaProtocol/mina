(library
 (name rosetta_coding)
 (public_name rosetta_coding)
 (library_flags -linkall)
 (libraries
  ;; opam libraries
  base
  core_kernel
  ;; local libraries
  mina_stdlib
  signature_lib
  snark_params)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps
   mina_ppx
   -allow-unannotated-ignores
   -allow-toplevel-expression
   -dont-check-underscored-literal))
 (synopsis "Encoders and decoders for Rosetta"))
