(library
 (name parallel_scan)
 (public_name parallel_scan)
 (inline_tests
  (flags -verbose -show-counts))
 (libraries
  ;; opam libraries
  core
  digestif
  ;; local libraries
  mina_stdlib
  ppx_version.runtime)
 (preprocess
  (pps
   ppx_assert
   ppx_bin_prot
   ppx_compare
   ppx_custom_printf
   ppx_inline_test
   ppx_let
   ppx_mina
   ppx_sexp_conv
   ppx_sexp_message
   ppx_version))
 (instrumentation
  (backend bisect_ppx))
 (synopsis "Parallel scan over an infinite stream (incremental map-reduce)"))
