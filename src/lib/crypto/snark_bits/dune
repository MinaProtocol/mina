(library
 (name snark_bits)
 (public_name snark_bits)
 (library_flags -linkall)
 (inline_tests
  (flags -verbose -show-counts))
 (libraries
  ;; opam libraries
  core_kernel
  integers
  base
  ;; local libraries
  fold_lib
  snarky.backendless
  tuple_lib
  bitstring_lib
