(library
 (name mina_version_runtime)
 (libraries core_kernel base unix)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps
   mina_ppx
   -allow-unannotated-ignores
   -allow-toplevel-expression
   -dont-check-underscored-literal))
 (public_name mina_version.runtime)
 (implements mina_version))
