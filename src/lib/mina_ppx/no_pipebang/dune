; As `mina_ppx`, without `ppx_pipebang`. This lists the parts of `ppx_jane`
; other than `ppx_pipebang`, in place of `ppx_jane` itself.
;
; `ppx_pipebang` inlines `x |> f` as `f x`, which changes the order in which
; `x` and `f` are evaluated when `f` is itself an application. In checked
; computations, that order is the order the constraints are added in, and so
; part of the circuit. This is for code written without `ppx_pipebang`, where
; adding it would change behaviour.

(library
 (name mina_ppx_no_pipebang)
 (public_name mina_ppx.no_pipebang)
 (kind ppx_rewriter)
 (modules)
 (libraries
  base_quickcheck.ppx_quickcheck
  h_list.ppx
  ppx_annot
  ppx_assert
  ppx_base
  ppx_bench
  ppx_bin_prot
  ppx_custom_printf
  ppx_deriving.std
  ppx_expect
  ppx_fields_conv
  ppx_fixed_literal
  ppx_here
  ppx_inline_test
  ppx_let
  ppx_mina
  ppx_module_timer
  ppx_optcomp
  ppx_optional
  ppx_sexp_message
  ppx_sexp_value
  ppx_snarky
  ppx_stable
  ppx_string
  ppx_typerep_conv
  ppx_variants_conv
  ppx_version))
